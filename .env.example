# Copy to .env.local for local development. Never commit the real .env.local.
# Production values are set in the Vercel project settings.

# Browser-facing origin of the Express API. This is an address, not a secret.
# In production this must be the HTTPS URL of the long-running backend host.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional debugging flag for checkout diagnostics. Leave unset in production.
# STRIPE_CHECKOUT_DIAGNOSTICS=1

# No NEXT_PUBLIC_ Stripe key is required: Checkout is created by the backend
# and the browser only follows Stripe-hosted URLs. Backend secrets (MongoDB,
# Stripe secret/webhook keys, ImgBB key, Better Auth secret, Google OAuth
# credentials and JWT/JWKS settings) must never be added here.
